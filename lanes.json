{
  "_about": "Who owns which files. bin/lane-check enforces it. Integrator-owned: everything not listed under a lane.",
  "every_lane_also_owns": [
    "changes/{lane}.md",
    "requests/{lane}.md",
    "docs/ops/runs/{lane}.md"
  ],
  "gates": [
    "bun run typecheck",
    "bun test",
    "bun bin/lane-check.ts {lane}"
  ],
  "lanes": {
    "partner-client": {
      "wave": 1,
      "model": "sonnet",
      "owns": [
        "src/partner/**",
        "test/partner/**"
      ]
    },
    "catalogue-store": {
      "wave": 1,
      "model": "sonnet",
      "owns": [
        "src/catalogue/**",
        "test/catalogue/**"
      ]
    },
    "search": {
      "wave": 1,
      "model": "sonnet",
      "owns": [
        "src/search/**",
        "test/search/**",
        "test/eval/**",
        "bin/eval-search.ts"
      ]
    },
    "carts": {
      "wave": 1,
      "model": "sonnet",
      "owns": [
        "src/carts/**",
        "test/carts/**"
      ]
    },
    "shopping": {
