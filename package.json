{
  "name": "zorasocial",
  "private": true,
  "type": "module",
  "description": "Zora Agent Lab: price truth monitor, partner experience probe and agent shopping tool on the Groupon Partner Storefront API",
  "scripts": {
    "dev": "wrangler dev",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.scripts.json",
    "gates": "bun run typecheck && bun test",
    "gen:contracts": "openapi-typescript docs/reference/partner-openapi-v003.json -o src/contracts/partner.gen.ts",
    "db:init": "wrangler d1 migrations apply zorasocial --local",
    "db:init:remote": "wrangler d1 migrations apply zorasocial --remote"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250920.0",
    "bun-types": "^1.3.14",
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.7.2",
    "wrangler": "^4.0.0"
  }
}
